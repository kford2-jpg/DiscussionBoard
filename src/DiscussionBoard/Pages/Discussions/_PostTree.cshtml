@model DiscussionBoard.Services.PostTreeBuilder.Node
@using DiscussionBoard.Services

@{
    var authorName = string.IsNullOrWhiteSpace(Model.Post.ApplicationUser?.DisplayName)
        ? "Unconfigured User"
        : Model.Post.ApplicationUser.DisplayName;

    var avatarId = AvatarCatalog.IsValid(Model.Post.ApplicationUser?.AvatarId)
        ? Model.Post.ApplicationUser!.AvatarId
        : AvatarCatalog.DefaultId;
}

<article class="border rounded p-3 mb-3"
         aria-label="Post"
         data-post-id="@Model.Post.Id">

    <div class="d-flex align-items-center gap-2 mb-2">
        <img src="@AvatarCatalog.ImagePath(avatarId)"
             alt="@authorName avatar"
             class="rounded-circle"
             style="width:40px;height:40px;object-fit:cover;" />

        <small class="text-muted">
            <strong>@authorName</strong>
            · @Model.Post.CreatedAt.ToLocalTime().ToString("g")
        </small>
    </div>

    <p class="mb-1">@Model.Post.Content</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <details class="mt-2">
            <summary class="btn btn-sm btn-outline-primary">
                Reply to this post
            </summary>

            <form method="post"
                  asp-page-handler="Reply"
                  asp-route-threadId="@Model.Post.DiscussionThreadId"
                  class="mt-2">

                <input type="hidden"
                       name="Input.ParentPostId"
                       value="@Model.Post.Id" />

                <label for="reply-@Model.Post.Id">Your reply</label>

                <textarea id="reply-@Model.Post.Id"
                          name="Input.Content"
                          class="form-control"
                          required
                          maxlength="10000"></textarea>

                <button type="submit"
                        class="btn btn-primary btn-sm mt-2">
                    Post reply
                </button>
            </form>
        </details>
    }

    @* This recursively displays replies to build the visual hierarchy. *@
    @if (Model.Replies.Count > 0)
    {
        <div class="ms-4 mt-3 ps-3 border-start border-3"
             aria-label="Replies to this post">

            @foreach (var reply in Model.Replies)
            {
                <partial name="/Pages/Discussions/_PostTree.cshtml"
                         model="reply" />
            }
        </div>
    }
</article>
