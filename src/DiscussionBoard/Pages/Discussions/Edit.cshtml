@page "{id:int}"
@model DiscussionBoard.Pages.Discussions.EditModel

    @{
    ViewData["Title"] = "Edit Discussion";
}

<div class="container mt-4">
    <h1>Edit Discussion</h1>

    <form method="post">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"
class="text-danger mb-3"></div>

    <div class="mb-3">
    <label asp-for="Input.Title" class="form-label">Title</label>
    <input asp-for="Input.Title" class="form-control" />
    <span asp-validation-for="Input.Title"
class="text-danger"></span>
    </div>

    <div class="mb-3">
    <label asp-for="Input.Content" class="form-label">Content</label>
    <textarea asp-for="Input.Content" class="form-control"
rows="7"></textarea>
    <span asp-validation-for="Input.Content"
class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
    Save Changes
    </button>

    <a asp-page="/Discussions/Details"
asp-route-threadId="@Model.Id"
class="btn btn-outline-secondary ms-2">
    Cancel
    </a>
    </form>
    </div>

    @section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
