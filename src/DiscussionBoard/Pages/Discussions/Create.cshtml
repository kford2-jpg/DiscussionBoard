@page
@model DiscussionBoard.Pages.Discussions.CreateModel

@{
    ViewData["Title"] = "Start a Discussion";
}

<div class="container mt-4">
    <h1>Start a Discussion</h1>

    <p class="text-muted">
        Forum: @(Model.Forum?.Name ?? "Selected forum")
    </p>

    <form method="post">
        <input type="hidden" asp-for="ForumId" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.Title" class="form-label">
                Discussion title
            </label>
            <input asp-for="Input.Title" class="form-control"
                   maxlength="200" />
            <span asp-validation-for="Input.Title"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Input.Content" class="form-label">
                Your discussion
            </label>
            <textarea asp-for="Input.Content" class="form-control"
                      rows="7" maxlength="10000"></textarea>
            <span asp-validation-for="Input.Content"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Create Discussion
        </button>

        <a asp-page="/Forums/Details"
           asp-route-id="@Model.ForumId"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
