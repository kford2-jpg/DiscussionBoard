@page
@model DiscussionBoard.Pages.MyProfileModel
@using DiscussionBoard.Services

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success" role="alert">
        @Model.SuccessMessage
    </div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Input.DisplayName" class="form-label">
            Display Name
        </label>
        <input asp-for="Input.DisplayName" class="form-control" />
        <span asp-validation-for="Input.DisplayName"
              class="text-danger"></span>
    </div>

    <fieldset class="mb-3">
        <legend class="form-label">Choose Your Avatar</legend>

        <div class="row g-3">
            @foreach (var avatar in Model.AvatarOptions)
            {
                <div class="col-6 col-md-4">
                    <label for="avatar-@avatar.Id"
                           class="d-flex align-items-center gap-2 border rounded p-3 h-100">
                        <input type="radio"
                               asp-for="Input.AvatarId"
                               value="@avatar.Id"
                               id="avatar-@avatar.Id" />

                        <img src="@AvatarCatalog.ImagePath(avatar.Id)"
                             alt="@avatar.DisplayName avatar"
                             class="rounded-circle"
                             style="width:50px;height:50px;object-fit:cover;" />

                        <span>@avatar.DisplayName</span>
                    </label>
                </div>
            }
        </div>

        <span asp-validation-for="Input.AvatarId"
              class="text-danger"></span>
    </fieldset>

    <button type="submit" class="btn btn-primary">
        Save Profile
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
