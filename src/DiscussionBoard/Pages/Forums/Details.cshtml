@page "/Forum/{id:int}"
@model DiscussionBoard.Pages.Forums.DetailsModel

@{
    ViewData["Title"] = Model.Forum?.Name ?? "Forum Details";
}

<div class="container mt-4">
    <a asp-page="/Forums/Index"
       class="btn btn-outline-secondary mb-3">
        Back to Forums
    </a>

    <h1>@Model.Forum?.Name</h1>
    <p class="text-muted">@Model.Forum?.Description</p>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Discussion Threads</h2>

        <a asp-page="/Discussions/Create"
           asp-route-forumId="@Model.Forum?.Id"
           class="btn btn-primary">
            Start a Discussion
        </a>
    </div>

    @if (Model.Threads.Count == 0)
    {
        <p>No discussions have been started in this forum yet.</p>
    }
    else
    {
        @foreach (var thread in Model.Threads)
        {
            <partial name="_ThreadCard" model="thread" />
        }
    }
</div>
