@page "/Forums/Index"
@model ForumsModel

@{
    ViewData["Title"] = "Forums";
}

<h1>Forums</h1>

@if (Model.Items == null || !Model.Items.Any())
{
    <p>No forums are available yet.</p>
}
else
{
    @foreach (var forum in Model.Items)
    {
        <partial name="/Pages/Forums/_ForumCard.cshtml" model="forum" />
    }
}
